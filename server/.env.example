# Copie para .env e ajuste.

# SQLite (padrão, não precisa instalar nada):
DATABASE_URL="file:./dev.db"

# PostgreSQL:   DATABASE_URL="postgresql://usuario:senha@localhost:5432/estoque"
# MySQL:        DATABASE_URL="mysql://usuario:senha@localhost:3306/estoque"
# SQL Server:   DATABASE_URL="sqlserver://localhost:1433;database=estoque;user=sa;password=SuaSenha;trustServerCertificate=true"
# (lembre de trocar o "provider" em prisma/schema.prisma junto)

# Gere uma chave forte: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="troque-esta-chave"
JWT_EXPIRES_IN="8h"
PORT=3001
CORS_ORIGIN="http://localhost:5173"
