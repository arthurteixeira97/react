# Copie para .env e ajuste.

# Supabase (PostgreSQL) — pegue em supabase.com > seu projeto > Project Settings > Database.
# DATABASE_URL = connection string no modo "Transaction" / pooler (porta 6543)
# DIRECT_URL   = connection string no modo "Session" / direta (porta 5432) — usada pelas migrações
DATABASE_URL="postgresql://usuario:senha@aws-x-xxxx.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://usuario:senha@aws-x-xxxx.pooler.supabase.com:5432/postgres"

# Gere uma chave forte: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="troque-esta-chave"
JWT_EXPIRES_IN="8h"
PORT=3001
CORS_ORIGIN="http://localhost:5173"
